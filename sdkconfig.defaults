# Defaults for the ESP32-S3-DevKitC-1 with the ESP32-S3-WROOM-1 N16R8 module.
# idf.py generates sdkconfig from this file; edit here, not there.

CONFIG_IDF_TARGET="esp32s3"

# 16 MB flash
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# 8 MB octal PSRAM (uses GPIO35-37). Boot continues without it so a board
# with a different module still gets far enough to say so.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# Console and logs on UART0, the "COM"/"UART" jack. The native "USB" jack is
# reserved for the mock radio's own USB device.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Optimise for speed. ESP-IDF's default is -Og, under which fading took most
# of each 5 ms audio block on core 1 and could fall behind for good.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# USB audio (espressif/usb_device_uac), used as one function of our own
# composite device: 48 kHz 16-bit mono playback and capture. The descriptors
# and tusb_config.h are in components/usb_composite.
CONFIG_USB_DEVICE_UAC_AS_PART=y
CONFIG_UAC_SPEAKER_CHANNEL_NUM=1
CONFIG_UAC_MIC_CHANNEL_NUM=1
CONFIG_UAC_SAMPLE_RATE=48000
CONFIG_UAC_BIT_RESOLUTION_16=y
# Rate-feedback format that macOS accepts on full-speed devices.
CONFIG_UAC_SUPPORT_MACOS=y
# The component hands each 1 ms playback packet from the USB interrupt to its
# speaker task through a single buffer, so a packet is lost whenever that task
# waits more than 1 ms for a processor. At its default (priority 5, either
# core) Wi-Fi and lwIP on the same core cost one packet every 20 to 30 s on the
# first board. Keep the USB tasks on core 1, above lwIP, and lwIP on core 0
# with Wi-Fi. The TinyUSB task is the highest of the three: it empties the
# interrupt's event queue, and below the audio tasks a long audio block let
# that queue overflow and wedge the CAT port (see tusb_config.h).
CONFIG_UAC_TINYUSB_TASK_PRIORITY=15
CONFIG_UAC_TINYUSB_TASK_CORE=1
CONFIG_UAC_SPK_TASK_PRIORITY=14
CONFIG_UAC_SPK_TASK_CORE=1
CONFIG_UAC_MIC_TASK_PRIORITY=13
CONFIG_UAC_MIC_TASK_CORE=1
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y

# Web console: the HTTP server needs WebSocket support for the live
# telemetry. Wi-Fi network names and passwords do not belong in this file:
# set them in menuconfig (they stay in sdkconfig, which is not committed) or
# from the console's own Wi-Fi form.
CONFIG_HTTPD_WS_SUPPORT=y
# The waterfall's socket is marked when its handshake is done, which only this
# callback hears of: the server does not pass the handshake to the handler.
CONFIG_HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT=y

# Board health: let FreeRTOS keep each task's run time and list the tasks, for
# the health readings in the log and the web console. It costs a clock
# reading at every task switch. Without these the readings lack the processor
# load and the table of tasks, and everything else still works.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# Flash layout: partitions.csv. 2 MB for the firmware, which with Wi-Fi is
# about 1 MB, and the rest of the 16 MB for clips.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
